#:culture{:id "som.dish.bariis-iskukaris", :name "Bariis iskukaris", :country "SOM", :kind :dish, :summary "Rice dish cooked in a single pan with meat, raisins, peas and the xawaash spice blend; the article states it is a national dish of Somalia and a staple almost universally served as part of a daily Somali meal.", :url "https://en.wikipedia.org/wiki/Bariis_iskukaris", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Lahoh", :id "som.dish.lahoh", :kind :dish, :name-local "Canjeero", :country "SOM", :retrieved-at "2026-07-17", :summary "Fermented spongy flatbread also called canjeero or canjeelo in Somalia, eaten regularly there and in Somaliland; a festive variant, cambaabur, is traditionally eaten at breakfast during Eid.", :name "Lahoh", :url-provenance :wikipedia-en}
#:culture{:id "som.dish.xalwo", :name "Xalwo", :country "SOM", :kind :dish, :summary "Somali variant of halva, made from sugar, oil and cornstarch flavored with cardamom, nutmeg or cloves and sometimes peanuts; the article states it is known in Somalia as xalwo (also halwo or halwa).", :url "https://en.wikipedia.org/wiki/Halva", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "som.beverage.camel-milk", :name "Camel milk", :country "SOM", :kind :beverage, :summary "The article's production statistics show Somalia led world camel-milk production in 2017 with 953,673 tonnes, the highest global output that year.", :url "https://en.wikipedia.org/wiki/Camel_milk", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Boswellia_frereana", :id "som.product.frankincense", :kind :product, :name-local "Maydi", :country "SOM", :retrieved-at "2026-07-17", :summary "Boswellia frereana, native to northern Somalia (local names include yagcar and yagar), produces frankincense resin known locally as maydi or fooh and described in the article as \"the king of all frankincense\"; scientific evidence confirms the tree is endemic to Somalia.", :name "Frankincense", :url-provenance :wikipedia-en}
#:culture{:id "som.heritage.laas-geel", :name "Laas Geel", :country "SOM", :kind :heritage, :summary "Cave rock-art site on the outskirts of Hargeisa in the Maroodi Jeex region, with paintings of domesticated cattle, herders, canines and giraffes estimated at 5,500 to 4,500 years old -- among the earliest known depictions of domesticated aurochs in the Horn of Africa; discovered by a French archaeological survey in 2002.", :url "https://en.wikipedia.org/wiki/Laas_Geel", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
